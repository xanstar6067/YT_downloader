<Window x:Class="YT_downloader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YT Downloader"
        Icon="/YtDlpDownloader;component/YT.ico"
        Width="920"
        Height="600"
        MinWidth="780"
        MinHeight="480"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Global User Interface"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>
    <Grid x:Name="LayoutRoot" Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,11,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="YT Downloader" />
            <TextBlock Grid.Column="1"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ToolStatusText}"
                       Text="{Binding ToolStatusText}" />
            <Button Grid.Column="2"
                    Width="128" Height="30"
                    Command="{Binding ToggleThemeCommand}"
                    Content="{Binding ThemeToggleText}" />
            <Button Grid.Column="3"
                    Margin="6,0,0,0"
                    Command="{Binding UpdateCommand}"
                    Width="128" Height="30"
                    Content="Обновить yt-dlp" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,11,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlTextBox"
                     MinHeight="30"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Вставьте ссылку на видео или плейлист" />
            <Button Grid.Column="1"
                    Margin="6,0,0,0"
                    Command="{Binding PasteCommand}"
                    Content="Вставить" />
            <CheckBox x:Name="PlaylistCheckBox"
                      Grid.Column="2"
                      Margin="12,0,6,0"
                      VerticalAlignment="Center"
                      Content="Весь плейлист"
                      IsEnabled="{Binding IsNotBusy}"
                      IsChecked="{Binding DownloadPlaylist}"
                      ToolTip="Включите для анализа и скачивания всех видео из плейлиста" />
            <Button Grid.Column="3"
                    Width="128" Height="30"
                    Command="{Binding AnalyzeCommand}"
                    Content="Анализировать"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <Border x:Name="PreviewCard" Grid.Row="2" Margin="0,0,0,8" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PreviewCover"
                      Width="128"
                      Height="72"
                      Background="{DynamicResource ThumbnailBackgroundBrush}">
                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" Text="Превью">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThumbnailUrl}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding MediaTypeText}" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               MaxHeight="40"
                               Text="{Binding VideoTitle}"
                               ToolTip="{Binding VideoTitle}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               Text="{Binding MediaDetailsText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Width="128" VerticalAlignment="Center">
                    <Button x:Name="DownloadButton"
                            Height="30"
                            Command="{Binding DownloadCommand}"
                            Content="Скачать"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="CancelButton"
                            Height="30" Margin="0,6,0,0"
                            Command="{Binding CancelCommand}"
                            Content="Отменить"
                            Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="OptionsCard" Grid.Row="3" Margin="0,0,0,8" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Папка" />
                    <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding SaveFolder, Mode=OneWay}" />
                    <Button Grid.Column="2" Width="128" Height="30" Margin="6,0,0,0"
                            Command="{Binding SelectFolderCommand}"
                            Content="Выбрать…" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Режим" />
                        <ComboBox ItemsSource="{Binding ModeOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedMode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Макс. качество" />
                        <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedResolution}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Фрагментов" />
                        <ComboBox ItemsSource="{Binding ConcurrentFragmentsOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedConcurrentFragments}"
                                  ToolTip="Число одновременно скачиваемых фрагментов видео/аудио. Больше потоков — быстрее загрузка, но выше нагрузка на сеть и риск ограничений со стороны сервера." />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Аудиодорожка" />
                        <ComboBox ItemsSource="{Binding AudioTrackOptions}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsAudioTrackSelectionEnabled}"
                                  SelectedItem="{Binding SelectedAudioTrack}"
                                  ToolTip="Для плейлиста используется автоматический выбор дорожки" />
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Сессия браузера" />
                        <ComboBox ItemsSource="{Binding BrowserCookieOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedBrowserCookieSource}"
                                  ToolTip="Используйте после прохождения CAPTCHA в обычном окне этого браузера. Cookies читаются только при явном выборе." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="ProgressCard" Grid.Row="4" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding StatusText}" ToolTip="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="12"
                           Text="{Binding ProgressValue, StringFormat={}{0:0}%}" />
            </Grid>
            <ProgressBar Grid.Row="1" Height="8"
                         Maximum="100"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         Background="{DynamicResource ProgressTrackBrush}"
                         Foreground="{DynamicResource AccentBrush}" />
            <StackPanel Grid.Row="2" Margin="0,4,0,0" Orientation="Horizontal" TextElement.FontSize="12">
                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Скорость " />
                <TextBlock Text="{Binding Speed}" />
                <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Размер " />
                <TextBlock Text="{Binding FileSize}" />
                <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Осталось " />
                <TextBlock Text="{Binding RemainingTime}" />
            </StackPanel>
        </Grid>

        <Border x:Name="LogCard" Grid.Row="5"
                Background="{DynamicResource InputBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <RichTextBox x:Name="LogRichTextBox"
                         MinHeight="0"
                         Padding="6,4"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Global Monospace"
                         FontSize="12"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto">
                <FlowDocument PagePadding="0" />
            </RichTextBox>
        </Border>

    </Grid>
</Window>
