<Window x:Class="YT_downloader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YT Downloader"
        Icon="/YT.ico"
        Width="1100"
        Height="820"
        MinWidth="920"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Global User Interface">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Text="YT Downloader" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Скачивание видео и плейлистов с помощью yt-dlp" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button MinWidth="125"
                            Command="{Binding ToggleThemeCommand}"
                            Content="{Binding ThemeToggleText}" />
                    <Button Margin="10,0,0,0"
                            Command="{Binding UpdateCommand}"
                            Content="Обновить yt-dlp" />
                </StackPanel>
                <TextBlock Margin="0,7,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           Text="{Binding ToolStatusText}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,14"
                Padding="16"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox MinHeight="42"
                         VerticalContentAlignment="Center"
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Вставьте ссылку на видео или плейлист" />
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Command="{Binding PasteCommand}"
                        Content="Вставить" />
                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        Command="{Binding AnalyzeCommand}"
                        Content="Анализировать"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <CheckBox Grid.Row="1"
                          Grid.ColumnSpan="3"
                          Margin="2,11,0,0"
                          Content="Скачать весь плейлист"
                          IsEnabled="{Binding IsNotBusy}"
                          IsChecked="{Binding DownloadPlaylist}"
                          ToolTip="Включите для анализа и скачивания всех видео из плейлиста" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid Height="170">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource ThumbnailBackgroundBrush}" CornerRadius="8" ClipToBounds="True">
                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,6,6,6" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   Text="{Binding MediaTypeText}" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding VideoTitle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding MediaDetailsText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="18"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Параметры сохранения" />
                    <TextBlock Grid.Row="1" Margin="0,12,0,5"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Папка" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="True" Text="{Binding SaveFolder, Mode=OneWay}" />
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Command="{Binding SelectFolderCommand}"
                                Content="Выбрать…" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Режим" />
                            <ComboBox ItemsSource="{Binding ModeOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedMode}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Макс. качество" />
                            <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedResolution}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Аудиодорожка" />
                            <ComboBox ItemsSource="{Binding AudioTrackOptions}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding IsAudioTrackSelectionEnabled}"
                                      SelectedItem="{Binding SelectedAudioTrack}"
                                      ToolTip="Для плейлиста используется автоматический выбор дорожки" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Сессия браузера" />
                            <ComboBox ItemsSource="{Binding BrowserCookieOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedBrowserCookieSource}"
                                      ToolTip="Используйте после прохождения CAPTCHA в обычном окне этого браузера. Cookies читаются только при явном выборе." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,0,0,14"
                Padding="18,15"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Height="10"
                             Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Background="{DynamicResource ProgressTrackBrush}"
                             Foreground="{DynamicResource AccentBrush}" />
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Скорость" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Speed}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Размер" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding FileSize}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Осталось" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding RemainingTime}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Margin="0,0,0,14"
                Padding="12"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="4,0,0,8" FontWeight="SemiBold" Text="Журнал выполнения" />
                <TextBox Grid.Row="1"
                         MinHeight="100"
                         Padding="10"
                         AcceptsReturn="True"
                         FontFamily="Global Monospace"
                         FontSize="12"
                         IsReadOnly="True"
                         Text="{Binding LogText, Mode=OneWay}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    MinWidth="125"
                    Margin="12,0,0,0"
                    Command="{Binding CancelCommand}"
                    Content="Отменить"
                    Style="{StaticResource DangerButtonStyle}" />
            <Button Grid.Column="2"
                    MinWidth="150"
                    Margin="12,0,0,0"
                    Command="{Binding DownloadCommand}"
                    Content="Скачать"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
