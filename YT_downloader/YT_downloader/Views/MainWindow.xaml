<Window x:Class="YT_downloader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YT Downloader"
        Width="1100"
        Height="820"
        MinWidth="920"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Text="YT Downloader" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Скачивание доступных вам видео с помощью yt-dlp" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Command="{Binding UpdateCommand}" Content="Обновить yt-dlp" />
                <TextBlock Margin="0,7,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Text="{Binding ToolStatusText}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,14"
                Padding="16"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox MinHeight="42"
                         VerticalContentAlignment="Center"
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Вставьте ссылку на видео" />
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Command="{Binding PasteCommand}"
                        Content="Вставить" />
                <Button Grid.Column="2"
                        Margin="10,0,0,0"
                        Command="{Binding AnalyzeCommand}"
                        Content="Анализировать"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid Height="170">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#080D18" CornerRadius="8" ClipToBounds="True">
                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,6,6,6" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Text="НАЙДЕННОЕ ВИДЕО" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding VideoTitle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding DurationText, StringFormat=Длительность: {0}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="18"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Параметры сохранения" />
                    <TextBlock Grid.Row="1" Margin="0,12,0,5"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Папка" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="True" Text="{Binding SaveFolder, Mode=OneWay}" />
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Command="{Binding SelectFolderCommand}"
                                Content="Выбрать…" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,5"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Режим" />
                            <ComboBox ItemsSource="{Binding ModeOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedMode}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,5"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Макс. качество" />
                            <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedResolution}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock Margin="0,0,0,5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Аудиодорожка" />
                        <ComboBox ItemsSource="{Binding AudioTrackOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedAudioTrack}"
                                  ToolTip="Список формируется после анализа ссылки" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,0,0,14"
                Padding="18,15"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Height="10"
                             Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Background="#07101F"
                             Foreground="{StaticResource AccentBrush}" />
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Скорость" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Speed}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Размер" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding FileSize}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Осталось" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding RemainingTime}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Margin="0,0,0,14"
                Padding="12"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="4,0,0,8" FontWeight="SemiBold" Text="Журнал выполнения" />
                <TextBox Grid.Row="1"
                         MinHeight="100"
                         Padding="10"
                         AcceptsReturn="True"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         Text="{Binding LogText, Mode=OneWay}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    MinWidth="125"
                    Margin="12,0,0,0"
                    Command="{Binding CancelCommand}"
                    Content="Отменить"
                    Style="{StaticResource DangerButtonStyle}" />
            <Button Grid.Column="2"
                    MinWidth="150"
                    Margin="12,0,0,0"
                    Command="{Binding DownloadCommand}"
                    Content="Скачать"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
